# Copia este archivo a .env SOLO si quieres usar tu propio servidor de salas.
# Sin .env (o con la línea comentada) la app usa el servidor público: wss://pokequien-rooms.onrender.com

# Servidor en tu red local: arráncalo con `npm run server` y pon la IP de tu ordenador (ejemplo: 192.168.1.50).
# EXPO_PUBLIC_ROOM_SERVER_URL=ws://192.168.1.50:8787

# Servidor propio publicado en internet (Render u otro): usa wss://
# EXPO_PUBLIC_ROOM_SERVER_URL=wss://tu-servidor.onrender.com
