{
  "name": "pokequien",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/press-start-2p": "^0.4.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~58.0.19",
    "expo-asset": "~58.0.18",
    "expo-audio": "~58.0.10",
    "expo-clipboard": "~58.0.4",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-web": "^0.21.4",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "server": "node server/room-server.js",
    "server:help": "node server/room-server.js --help",
    "room-server": "node server/room-server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test server/room-server.test.js && tsx --test src/*.test.ts src/game/*.test.ts",
    "build:web": "node scripts/build-web.mjs",
    "test:web": "node scripts/smoke-web.mjs",
    "single-player:soak": "tsx scripts/single-player-soak-test.ts",
    "single-player:merge": "tsx scripts/merge-single-player-soak.ts",
    "single-player:fleet": "tsx scripts/single-player-national-fleet.ts",
    "single-player:verify": "tsx scripts/verify-single-player.ts"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "@expo/cli": {
      "zod": "^4.6.7"
    }
  }
